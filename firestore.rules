rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /business_profiles/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == userId
                                  && resource.data.uid == request.auth.uid;
    }

    match /products/{productId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null
                           && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }


    match /product_listings/{listingId} {
      allow create: if request.auth != null
                    && request.resource.data.sellerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0
                    && request.resource.data.status == 'active';
      allow read: if (resource.data.status == 'active')
                  || (request.auth != null && resource.data.sellerUid == request.auth.uid);
      allow update: if request.auth != null
                    && resource.data.sellerUid == request.auth.uid
                    && request.resource.data.sellerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.sellerUid == request.auth.uid;
    }

    match /marketplace_enquiries/{enquiryId} {
      allow create: if request.auth != null
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.sellerUid is string
                    && request.resource.data.sellerUid != request.auth.uid
                    && request.resource.data.listingId is string
                    && exists(/databases/$(database)/documents/product_listings/$(request.resource.data.listingId))
                    && get(/databases/$(database)/documents/product_listings/$(request.resource.data.listingId)).data.sellerUid == request.resource.data.sellerUid
                    && get(/databases/$(database)/documents/product_listings/$(request.resource.data.listingId)).data.status == 'active';
      allow read: if request.auth != null
                  && (resource.data.buyerUid == request.auth.uid
                      || resource.data.sellerUid == request.auth.uid);
      allow update: if request.auth != null
                    && resource.data.sellerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /marketing_campaigns/{campaignId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.status == 'draft';
      allow read, delete: if request.auth != null
                           && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    match /sales/{saleId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.productId is string
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0
                    && request.resource.data.unitPrice is number
                    && request.resource.data.unitPrice >= 0
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.uid == request.auth.uid
                    && (!('customerId' in request.resource.data)
                        || (request.resource.data.customerId is string
                            && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
                            && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.uid == request.auth.uid));
      allow read, delete: if request.auth != null
                           && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /customers/{customerId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow read, delete: if request.auth != null
                           && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
    }
  }
}